func main () {
  terminal.log(7 / 2);
  terminal.log(-7 / 2);
  terminal.log(7 % 3);
  terminal.log(-7 % 3);
  terminal.log(7.0 / 2);
  terminal.log(1 + 2.5);
  terminal.log(2 * 3.0);
  terminal.log(10 - 4);
  terminal.log(1 == 1.0);
  terminal.log(1 < 2.5);
  terminal.log(2.5 >= 2.5);
  terminal.log(3 != 3);
  terminal.log(1.0 / 0.0);
  terminal.log(-(5));
  terminal.log(2147483647);
  var f:float = 3;
  terminal.log(f);
  terminal.log(0.1 + 0.2);
}
